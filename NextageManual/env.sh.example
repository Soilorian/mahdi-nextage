# Optional planning environment. Copy to /home/mahdi/nextage/env.sh after
# installing Miniforge and creating the named Python 3.8 environment.
MY_ROOT=/home/mahdi/nextage
MY_CONDA_ENV=nextage

if [ ! -r "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    echo "Miniforge is missing at $HOME/miniforge3" >&2
    return 1
fi
. "$HOME/miniforge3/etc/profile.d/conda.sh"
conda activate "$MY_CONDA_ENV" || return 1
export PYTHONPATH="$MY_ROOT/bpbot-lab${PYTHONPATH:+:$PYTHONPATH}"
export BPBOT_EXP_DIR="$MY_ROOT/exp"
mkdir -p "$BPBOT_EXP_DIR"

cnoid() {
    "$MY_ROOT/choreonoid-1.7.0-lab/bin/choreonoid" "$@"
}
